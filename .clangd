# =============================================================================
# .clangd — clangd language-server config for this project
#
# IMPORTANT (why absolute -I paths):
#   When there is no compile_commands.json, clangd's fallback compile CWD is
#   the source file's directory (e.g. src/), NOT the project root.
#   So "-Iinclude" would look for src/include/ and fail.
#   Absolute -I paths always resolve correctly for src/, lib/, devices/, etc.
#
# Keep in sync with: Makefile → CFLAGS_COMMON (and x86 JSONC_CFLAGS)
# After editing: Ctrl+Shift+P → "clangd: Restart language server"
# =============================================================================

CompileFlags:
  Add:
    - -std=c11
    - -D_GNU_SOURCE
    - -Wall
    - -Wextra

    # Project headers (absolute = independent of which .c directory is open)
    - -I/home/eric/CM_LFB_UPS/include
    - -I/home/eric/CM_LFB_UPS/devices
    - -I/home/eric/CM_LFB_UPS/lib/alarm
    - -I/home/eric/CM_LFB_UPS/lib/cmos
    - -I/home/eric/CM_LFB_UPS/lib/modbus
    - -I/home/eric/CM_LFB_UPS/lib/device_map
    - -I/home/eric/CM_LFB_UPS/lib/log
    - -I/home/eric/CM_LFB_UPS/lib/sqlite3

    # System: pkg-config --cflags json-c
    - -I/usr/include/json-c
